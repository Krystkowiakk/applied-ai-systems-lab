# Only needed for the agent solver. The baselines and the tests need no keys.
# The CLI reads keys from the environment; export them or load this file with your shell.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional model overrides (defaults: gpt-5-mini, claude-opus-5-5)
# AISYSLAB_OPENAI_MODEL=
# AISYSLAB_ANTHROPIC_MODEL=

# Local OpenAI-compatible server (LM Studio default shown; Ollama: http://localhost:11434/v1)
# AISYSLAB_LOCAL_URL=http://localhost:1234/v1
# AISYSLAB_LOCAL_MODEL=
